SESSION_PASSWORD=your-32-char-minimum-secret-key-here
SESSION_COOKIE_NAME=sigorta-session
APP_PASSWORD=your-login-password

# Pipeline configuration (auto-detected if not set)
PYTHON_PATH=
LIBREOFFICE_PATH=

# Telegram bildirim entegrasyonu (opsiyonel — eksikse bildirimler atlanır, D-11)
#
# KURULUM (bot sadece sizin hesabınıza mesaj göndersin):
#
# 1. Token alın: Telegram → @BotFather → /newbot → kopyalanan token
#    GÜVENLİK: Token'ı kimseyle paylaşmayın, .env.local dışında saklamayın.
#    Token ele geçirilirse: @BotFather → /revoke ile hemen iptal edin.
TELEGRAM_BOT_TOKEN=
#
# 2. Kendi Chat ID'nizi bulun (bot sadece bu ID'ye mesaj gönderir):
#    Yöntem A: Telegram → @userinfobot'a herhangi bir mesaj atın → "Your ID: 123456789"
#    Yöntem B: Bota bir mesaj atın, sonra tarayıcıda açın:
#              https://api.telegram.org/bot{BURAYA_TOKEN}/getUpdates
#              → result[0].message.chat.id değerini kopyalayın
TELEGRAM_CHAT_ID=
#
# 3. Bot Privacy Mode — botu sadece size açık yapın:
#    Telegram → @BotFather → /setprivacy → botunuzu seçin → Disable
#    Bu ayar botun grup mesajlarını görmesini engeller (bireysel sohbetleri etkilemez).
#
# NOT: Bu uygulama botu yalnızca ÇIKIŞ YÖNLÜ kullanır — sadece TELEGRAM_CHAT_ID'ye
# bildirim gönderir, gelen mesajları okumaz/işlemez. Başka kullanıcılar bota mesaj
# atsa bile uygulama tarafından işlem yapılmaz.
