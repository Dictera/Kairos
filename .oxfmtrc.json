{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "drizzle/**",
    "data/**",
    "public/**",
    "**/*.md",
    "**/*.json",
    "**/*.yaml",
    "**/*.yml",
    "**/*.css"
  ]
}
