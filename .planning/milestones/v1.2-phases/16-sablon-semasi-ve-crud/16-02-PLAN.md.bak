       ```ts
       import { describe, it, expect } from 'vitest'
       import path from 'path'
       import { runSidecarCommand } from '@/lib/services/docx-pipeline'

       const fixture = path.resolve(process.cwd(), 'tests/fixtures/test-template.docx')

       describe('Sidecar: extract-vars (SABLON-03)', () => {
         it('extracts {{var}} and {%p var%} placeholders, deduped', async () => {
           const result = await runSidecarCommand({
             command: 'extract-vars',
             params: { file_path: fixture },
           })
           expect(result.status).toBe('success')
           // @ts-expect-error narrow
           expect(result.result.variables).toEqual(['muvekkil_ad', 'dosya_no', 'paragraf_blok'])
         }, 30_000)

         it('returns code=1 when file_path param is missing', async () => {
           const result = await runSidecarCommand({
             command: 'extract-vars',
             params: {},
           })
           expect(result.status).toBe('error')
           // @ts-expect-error narrow
           expect(result.code).toBe(1)
         }, 30_000)

         it('returns error when file does not exist', async () => {
           const result = await runSidecarCommand({
             command: 'extract-vars',
             params: { file_path: '/nonexistent/path.docx' },
           })
           expect(result.status).toBe('error')
         }, 30_000)
       })
       ```
